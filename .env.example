# ---- 模型 API 配置（可选）----
# 未配置 API Key 时，引擎会自动退化为内置的确定性「脚本模型」，
# 用于离线演示与自动化测试（可完整驱动 Agent Loop / 工具闭环）。
#
# 配置后即切换为真实 LLM 推理（支持任意标准 OpenAI 兼容接口，
# 亦可用 Anthropic 网关转成 OpenAI 格式后接入）。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 可选：单次回复最大 token 数
MAX_OUTPUT_TOKENS=4096

# Agent Loop 最大推理步数（含工具调用轮次），默认 8
DEFECT_AGENT_MAX_STEPS=8

# 高危工单审批策略：auto=自动放行（仅演示用）/ interactive=命令行 y/n / reject=自动拒绝
DEFECT_APPROVAL_MODE=interactive
